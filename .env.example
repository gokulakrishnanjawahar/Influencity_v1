# ── Deployer ──
# Wallet that deploys the contracts and signs backend transactions.
# Needs POL for gas on Polygon (not ETH).
PRIVATE_KEY=your_wallet_private_key_here

# ── RPC endpoints (Hardhat) ──
# One per network defined in hardhat.config.js. The public endpoints below
# work but are heavily rate-limited — use a provider (Alchemy, Infura,
# QuickNode) for anything beyond a one-off deploy.
POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Optional: pin the gas price (gwei) for Amoy deploys. The network's suggested
# price spikes erratically — 450+ gwei against a ~25-30 gwei floor — which turns
# a 0.2 POL deploy into a 3 POL one. Set to 30 when the quote looks wrong.
AMOY_GAS_PRICE_GWEI=
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com

# ── RPC endpoint (backend server) ──
# The single chain the Express API reads from. Must match the chain the
# contract addresses below were deployed to. No default — the server throws
# if this is missing, rather than silently querying the wrong chain.
RPC_URL=https://rpc-amoy.polygon.technology

# ── Contract verification ──
# Etherscan V2 uses ONE multichain key covering Polygon and Amoy.
# Get it from etherscan.io — standalone Polygonscan keys are deprecated.
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ── Deployed contract addresses ──
# Populated by scripts/deploy.js. Copy them from deployments.json after
# running the deploy, and mirror the VITE_ ones into client/.env.local.
CAMPAIGN_FACTORY_ADDRESS=
REPUTATION_TOKEN_ADDRESS=
USDC_ADDRESS=
MOCK_METRICS_ORACLE_ADDRESS=

# ── Database (Supabase) ──
# Project URL and the SERVICE ROLE key, not the anon key. The service role
# bypasses row-level security, which the backend needs in order to write.
# Never expose this key to the browser — the client uses the anon key instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── IPFS (Pinata) ──
# JWT from the Pinata dashboard, plus your dedicated gateway host.
# Used to pin campaign briefs and creator content proofs.
PINATA_JWT=your_pinata_jwt
PINATA_GATEWAY=your-gateway.mypinata.cloud

# ── Server ──
# Port the Express API listens on (defaults to 3001 when unset).
PORT=3001

# Origin allowed through CORS, in addition to localhost:5173 and *.vercel.app.
# Set this to your deployed frontend URL.
CLIENT_URL=http://localhost:5173

# Shared secret for POST /webhooks/*. If this is left unset the webhook routes
# accept unauthenticated calls and only log a warning — fine locally, unsafe in
# production, where anyone could write campaign state into your database.
WEBHOOK_SECRET=generate_a_long_random_string

# ── Chainlink Functions (oracle layer — scripts/deployOracle.js) ──
# Only needed to go past the mock oracle. Get the router address and DON ID
# from Chainlink's supported-networks docs for YOUR network — routers are
# network-specific and have been reissued before. A wrong router deploys
# cleanly and then never fulfils a single request.
FUNCTIONS_ROUTER_ADDRESS=
FUNCTIONS_SUBSCRIPTION_ID=
FUNCTIONS_DON_ID=fun-polygon-amoy-1

# Written by scripts/deployOracle.js
METRICS_CONSUMER_ADDRESS=
AUTOMATION_HANDLER_ADDRESS=

