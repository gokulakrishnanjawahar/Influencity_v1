# Copy to client/.env.local and fill in. Vite only exposes VITE_-prefixed vars.

# ── Wallet ──
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ── Chain ──
# Which chain the contract addresses below belong to.
# 80002 = Polygon Amoy (default), 137 = Polygon mainnet.
# NetworkGuard blocks transactions whenever the wallet is on a different chain.
VITE_CHAIN_ID=80002

# ── Contract addresses ──
# From deployments.json after running scripts/deploy.js.
VITE_CAMPAIGN_FACTORY_ADDRESS=
VITE_REPUTATION_TOKEN_ADDRESS=

# USDC for the target chain. No fallback — the app logs an error if unset.
#   Amoy    → the MockUSDC address from deployments.json
#   Mainnet → 0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359 (native USDC)
VITE_USDC_ADDRESS=

# ── Backend + services ──
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_PINATA_GATEWAY=your_pinata_gateway
